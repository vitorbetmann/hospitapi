        {
          "name": "List future appointments of patient 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "const list = body.data.appointmentsByPatient;",
                  "pm.test('Only future appointments', () => list.forEach(a => pm.expect(new Date(a.scheduledAt).getTime()).to.be.above(Date.now())));",
                  "pm.test('Soonest first', () => { for (let i = 1; i < list.length; i++) pm.expect(new Date(list[i].scheduledAt).getTime()).to.be.at.least(new Date(list[i-1].scheduledAt).getTime()); });"
                ]
              }
            }
