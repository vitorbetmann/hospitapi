          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query AppointmentsByPatient($patientId: ID!, $onlyFuture: Boolean) {\n  appointmentsByPatient(patientId: $patientId, onlyFuture: $onlyFuture) {\n    id\n    status\n    scheduledAt\n    reason\n    notes\n    patient { id }\n  }\n}\n",
