                  "pm.collectionVariables.set('soonAppointmentId', a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateAppointment($input: CreateAppointmentInput!) {\n  createAppointment(input: $input) {\n    id\n    status\n    scheduledAt\n    reason\n    notes\n    patient { id name }\n    doctor { id name }\n  }\n}\n",
                "variables": "{\n  \"input\": {\n    \"patientId\": \"{{patientId}}\",\n    \"doctorId\": \"{{doctorId}}\",\n    \"scheduledAt\": \"{{inTwoHours}}\",\n    \"reason\": \"Blood test results\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{schedulingUrl}}/graphql",
              "host": [
                "{{schedulingUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Falls inside the 24-hour reminder window, so the scheduling job publishes a REMINDER_DUE event on its next run (every 5 minutes). Watch `docker compose logs -f notification`."
          }
        },
        {
          "name": "Reschedule appointment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iso = ms => new Date(Date.now() + ms).toISOString().replace(/\\.\\d{3}Z$/, 'Z');",
                  "pm.collectionVariables.set('inThreeDays', iso(72 * 3600000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "const a = body.data.updateAppointment;",
                  "pm.test('Reason updated', () => pm.expect(a.reason).to.eql('Annual check-up (rescheduled)'));",
                  "pm.test('Rescheduled', () => pm.expect(new Date(a.scheduledAt).getTime()).to.eql(new Date(pm.collectionVariables.get('inThreeDays')).getTime()));"
                ]
              }
            }
