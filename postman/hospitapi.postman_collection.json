      "item": [
        {
          "name": "Notification health (details always shown)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status UP', () => pm.expect(body.status).to.eql('UP'));",
                  "pm.test('Details shown (D-020)', () => pm.expect(body.components).to.have.property('rabbit'));"
                ]
