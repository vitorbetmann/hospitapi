              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 (GraphQL reports errors in the body)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Classification is FORBIDDEN', () => pm.expect(body.errors[0].extensions.classification).to.eql('FORBIDDEN'));",
