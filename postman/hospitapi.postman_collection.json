      "item": [
        {
          "name": "Create appointment (in 2 days)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const iso = ms => new Date(Date.now() + ms).toISOString().replace(/\\.\\d{3}Z$/, 'Z');",
                  "pm.collectionVariables.set('inTwoDays', iso(48 * 3600000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
                  "const a = body.data.createAppointment;",
                  "pm.test('Created as SCHEDULED', () => pm.expect(a.status).to.eql('SCHEDULED'));",
                  "pm.collectionVariables.set('appointmentId', a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateAppointment($input: CreateAppointmentInput!) {\n  createAppointment(input: $input) {\n    id\n    status\n    scheduledAt\n    reason\n    notes\n    patient { id name }\n    doctor { id name }\n  }\n}\n",
                "variables": "{\n  \"input\": {\n    \"patientId\": \"{{patientId}}\",\n    \"doctorId\": \"{{doctorId}}\",\n    \"scheduledAt\": \"{{inTwoDays}}\",\n    \"reason\": \"Annual check-up\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{schedulingUrl}}/graphql",
              "host": [
                "{{schedulingUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Publishes a CREATED event. See it with `docker compose logs -f notification`."
          }
        },
        {
          "name": "Create appointment (in 2 hours, triggers reminder)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
